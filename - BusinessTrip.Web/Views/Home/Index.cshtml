@{
    ViewData["Title"] = "سفرهای سازمانی";
}

<style>
    .trip-home {
        direction: rtl;
        background: #f5f1e8;
        color: #343c32;
        min-height: 100vh;
        padding: 30px 5%;
        font-family: inherit;
    }

    .trip-wrapper {
        max-width: 1250px;
        margin: auto;
    }

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0 25px;
        border-bottom: 1px solid #dedbd0;
        margin-bottom: 35px;
    }

    .brand {
        font-size: 19px;
        font-weight: 900;
        color: #354b3b;
        letter-spacing: -.5px;
    }

        .brand span {
            color: #a17d4e;
        }

    .top-label {
        font-size: 12px;
        color: #8c8d7e;
        letter-spacing: 1px;
    }

    .hero {
        display: grid;
        grid-template-columns: 1.1fr .9fr;
        min-height: 390px;
        border-radius: 5px;
        overflow: hidden;
        margin-bottom: 65px;
        background: #354b3b;
    }

    .hero-content {
        padding: 55px 50px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        color: #fff;
    }

    .hero-eyebrow {
        color: #d5c39e;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        margin-bottom: 22px;
    }

    .hero h1 {
        font-size: 37px;
        line-height: 1.8;
        font-weight: 900;
        margin-bottom: 17px;
    }

    .hero p {
        color: #d8dfd3;
        font-size: 14px;
        line-height: 2.2;
        max-width: 470px;
        margin-bottom: 27px;
    }

    .hero-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: fit-content;
        padding: 13px 24px;
        background: #d4b889;
        color: #354b3b !important;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 800;
        transition: .2s;
    }

        .hero-button:hover {
            background: #e5cda7;
            transform: translateY(-2px);
        }

    .hero-art {
        position: relative;
        background: linear-gradient(145deg, #d9c6a5, #a58b64);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        min-height: 320px;
    }

    .sun {
        position: absolute;
        width: 190px;
        height: 190px;
        background: #f1dfb9;
        border-radius: 50%;
        top: 45px;
        right: 50%;
        transform: translateX(50%);
        opacity: .9;
    }

    .mountain {
        position: absolute;
        bottom: -65px;
        width: 0;
        height: 0;
        border-left: 190px solid transparent;
        border-right: 190px solid transparent;
        border-bottom: 270px solid #64765a;
    }

        .mountain.back {
            right: -50px;
            border-bottom-color: #8b9777;
            transform: scale(.85);
        }

        .mountain.front {
            left: -40px;
            border-bottom-color: #435b48;
            transform: scale(1.1);
        }

    .plane {
        position: absolute;
        top: 70px;
        left: 65px;
        font-size: 42px;
        color: #fff;
        transform: rotate(-12deg);
        z-index: 2;
    }

    .art-caption {
        position: absolute;
        bottom: 25px;
        right: 25px;
        z-index: 3;
        color: #fff;
        font-size: 12px;
        letter-spacing: 2px;
    }

    .intro-row {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

        .intro-row h2 {
            font-size: 25px;
            font-weight: 900;
            color: #354b3b;
            margin: 0 0 8px;
        }

        .intro-row p {
            font-size: 13px;
            color: #898b7e;
            margin: 0;
        }

    .section-number {
        color: #a17d4e;
        font-size: 38px;
        font-weight: 300;
        direction: ltr;
    }

    .destination-section {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 70px;
    }

    .destination-card {
        min-height: 185px;
        padding: 28px;
        background: #fff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border: 1px solid #e8e2d6;
        transition: .25s;
        text-decoration: none !important;
        color: #354b3b !important;
    }

        .destination-card:hover {
            transform: translateY(-5px);
            border-color: #b9a17a;
            box-shadow: 0 12px 25px rgba(60, 65, 45, .07);
        }

        .destination-card .number {
            color: #b39a70;
            font-size: 12px;
            letter-spacing: 2px;
        }

        .destination-card h3 {
            font-size: 19px;
            font-weight: 800;
            margin: 17px 0 8px;
        }

        .destination-card p {
            color: #85877c;
            font-size: 13px;
            line-height: 2;
            margin: 0;
        }

        .destination-card .arrow {
            align-self: flex-end;
            color: #a17d4e;
            font-size: 22px;
        }

    .journey-section {
        background: #e9e5d9;
        padding: 38px 40px;
        margin-bottom: 65px;
    }

        .journey-section h2 {
            color: #354b3b;
            font-size: 22px;
            font-weight: 900;
            margin-bottom: 30px;
        }

    .journey-steps {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .journey-step {
        border-right: 2px solid #b9a17a;
        padding: 5px 17px 5px 5px;
    }

        .journey-step strong {
            display: block;
            color: #354b3b;
            font-size: 14px;
            margin-bottom: 9px;
        }

        .journey-step span {
            color: #85877c;
            font-size: 12px;
            line-height: 1.9;
        }

    .footer-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 25px 0;
        border-top: 1px solid #dedbd0;
        color: #85877c;
        font-size: 12px;
    }

    .footer-brand {
        color: #354b3b;
        font-weight: 900;
        font-size: 15px;
    }

    @@media(max-width: 800px) {
        .hero {
            grid-template-columns: 1fr;
        }

        .hero-content {
            padding: 35px 25px;
        }

        .hero h1 {
            font-size: 27px;
        }

        .hero-art {
            min-height: 260px;
        }

        .journey-steps {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media(max-width: 550px) {
        .trip-home {
            padding: 20px 15px;
        }

        .destination-section {
            grid-template-columns: 1fr;
        }

        .journey-steps {
            grid-template-columns: 1fr;
        }

        .journey-section {
            padding: 25px 20px;
        }

        .top-label {
            display: none;
        }

        .footer-section {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="trip-home">
    <div class="trip-wrapper">

        <header class="topbar">
            <div class="brand">BUSINESS <span>TRIP</span></div>
            <div class="top-label">CORPORATE TRAVEL MANAGEMENT</div>
        </header>

        <section class="hero">
            <div class="hero-content">
                <div class="hero-eyebrow">TRAVEL BEYOND ROUTINE</div>

                <h1>
                    هر سفر سازمانی،
                    <br />
                    شروع یک مسیر تازه است.
                </h1>

                <p>
                    از ثبت درخواست تا انتخاب مقصد و هماهنگی خدمات سفر،
                    تمام مراحل سفرهای سازمانی را در یک مسیر منظم مدیریت کنید.
                </p>

                <a href="@Url.Action("Index", "Destinations")"
                   class="hero-button">
                    کشف مقصدهای سفر ←
                </a>
            </div>

            <div class="hero-art">
                <div class="sun"></div>
                <div class="mountain back"></div>
                <div class="mountain front"></div>
                <div class="plane">✈</div>
                <div class="art-caption">EXPLORE · PLAN · TRAVEL</div>
            </div>
        </section>

        <section>
            <div class="intro-row">
                <div>
                    <h2>مدیریت سفرها</h2>
                    <p>از اینجا مسیر موردنظرت را انتخاب کن.</p>
                </div>
                <div class="section-number">01 / 03</div>
            </div>

            <div class="destination-section">

                <a href="@Url.Action("Index", "Destinations")"
                   class="destination-card">
                    <div>
                        <div class="number">01 — DESTINATIONS</div>
                        <h3>مقصدهای سفر</h3>
                        <p>مشاهده و مدیریت شهرها و مقصدهای تعریف‌شده در سامانه.</p>
                    </div>
                    <div class="arrow">←</div>
                </a>

                <a href="@Url.Action("Active", "Destinations")"
                   class="destination-card">
                    <div>
                        <div class="number">02 — ACTIVE PLACES</div>
                        <h3>مقصدهای فعال</h3>
                        <p>دسترسی به مقصدهایی که امکان انتخاب آن‌ها وجود دارد.</p>
                    </div>
                    <div class="arrow">←</div>
                </a>

                <a href="@Url.Action("Index", "BusinessTripRequests")"
                   class="destination-card">
                    <div>
                        <div class="number">03 — TRIP REQUESTS</div>
                        <h3>درخواست‌های سفر</h3>
                        <p>ثبت و پیگیری درخواست‌های سفر سازمانی.</p>
                    </div>
                    <div class="arrow">←</div>
                </a>

                <a href="@Url.Action("Index", "Home")"
                   class="destination-card">
                    <div>
                        <div class="number">04 — OVERVIEW</div>
                        <h3>نمای کلی سامانه</h3>
                        <p>آشنایی با مراحل و امکانات مدیریت سفرهای سازمانی.</p>
                    </div>
                    <div class="arrow">←</div>
                </a>

            </div>
        </section>

        <section class="journey-section">
            <h2>یک سفر سازمانی چگونه پیش می‌رود؟</h2>

            <div class="journey-steps">
                <div class="journey-step">
                    <strong>۱. ثبت درخواست</strong>
                    <span>ثبت اطلاعات اولیه و هدف سفر سازمانی</span>
                </div>

                <div class="journey-step">
                    <strong>۲. انتخاب مقصد</strong>
                    <span>انتخاب شهر و خدمات موردنیاز سفر</span>
                </div>

                <div class="journey-step">
                    <strong>۳. تأیید درخواست</strong>
                    <span>بررسی و طی مراحل تأیید سازمانی</span>
                </div>

                <div class="journey-step">
                    <strong>۴. برنامه‌ریزی سفر</strong>
                    <span>هماهنگی رزروها و خدمات سفر</span>
                </div>
            </div>
        </section>

        <footer class="footer-section">
            <div class="footer-brand">BUSINESS TRIP MANAGEMENT</div>
            <div>سامانه مدیریت و برنامه‌ریزی سفرهای سازمانی</div>
        </footer>

    </div>
</div>
